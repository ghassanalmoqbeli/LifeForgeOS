    (id, taskId, date, value, isCompleted, notes, createdAt, updatedAt, deviceId, syncStatus)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTimerPresetById:
SELECT * FROM TimerPreset WHERE id = ? AND deletedAt IS NULL;

deleteTimerPreset:
UPDATE TimerPreset SET deletedAt = ?, updatedAt = ?, syncStatus = 'Pending' WHERE id = ?;

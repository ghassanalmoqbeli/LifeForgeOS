-- ============================================================

deleteBook:
UPDATE Book SET deletedAt = ?, updatedAt = ?, syncStatus = 'Pending' WHERE id = ?;

deleteCourse:
UPDATE Course SET deletedAt = ?, updatedAt = ?, syncStatus = 'Pending' WHERE id = ?;

deleteMediaItem:
UPDATE MediaItem SET deletedAt = ?, updatedAt = ?, syncStatus = 'Pending' WHERE id = ?;

